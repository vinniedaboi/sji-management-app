# --- Database (Supabase Postgres) ---------------------------------------
# Copy the connection string from the Supabase dashboard: Connect → ORM /
# "Connection pooling". Use the TRANSACTION pooler (port 6543) for the
# deployed app (serverless/Vercel). The app's tables live in a dedicated
# "staffhub" schema, so this database can host other apps too.
#
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>.pooler.supabase.com:6543/postgres
#
DATABASE_URL=
# Schema the app uses (leave as-is unless you deliberately renamed it).
DATABASE_SCHEMA=staffhub

# Long random string used to sign session cookies. REQUIRED in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-a-long-random-string-for-production

# --- School branding (safe to expose to the browser) --------------------
NEXT_PUBLIC_SCHOOL_NAME=St. Joseph's Institution International
NEXT_PUBLIC_SCHOOL_LOGO_URL=https://resources.finalsite.net/images/v1737511103/sjiinternationalcomsg/b5e2sg6iwtc63oze5upz/St-Josephs-Institution-International-Logo-White.svg
NEXT_PUBLIC_SCHOOL_TIMEZONE=Asia/Singapore
